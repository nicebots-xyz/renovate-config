{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for nicebots-xyz repositories.",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "commitMessageAction": "Upgrade",
  "assigneesFromCodeOwners": true,
  "pinDigests": true,
  "platformAutomerge": false,
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com",
    "/^\\d+\\+nicebots-autofixer\\[bot\\]@users\\.noreply\\.github\\.com$/"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "group": {
    "commitMessageTopic": "{{{groupName}}}{{#with (distinct (lookupArray upgrades \"depName\")) as |names|}}{{#if names.[1]}} ({{#each names}}{{#if (or (equals @index 0) (equals @index 1) (equals @index 2) (equals @index 3) (equals @index 4) (equals @index 5))}}{{#if @index}}, {{/if}}{{{this}}}{{/if}}{{/each}}{{#if names.[6]}} and {{add names.length -6}} more{{/if}}){{/if}}{{/with}}"
  },
  "labels": [
    "deps"
  ],
  "packageRules": [
    {
      "description": "Commit message verbs for non-upgrade update types.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "commitMessageAction": "Pin"
    },
    {
      "matchUpdateTypes": [
        "rollback"
      ],
      "commitMessageAction": "Downgrade"
    },
    {
      "description": "Maintain the lock files of each package manager in their own pull request, so one failing to update never holds back another.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "branchTopic": "lock-file-maintenance-{{{manager}}}",
      "commitMessageAction": "Update",
      "commitMessageTopic": "{{{manager}}} lock file"
    },
    {
      "description": "Name lock file maintenance pull requests after their ecosystem.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "pep621",
        "poetry",
        "pipenv",
        "pip-compile"
      ],
      "commitMessageTopic": "Python lock file"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "npm",
        "bun"
      ],
      "commitMessageTopic": "JavaScript lock file"
    },
    {
      "description": "Wait 7 days before proposing an npm release, so malware scanners can flag it and a pulled release never lands. strict: no branch is created until the age is met.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Wait 7 days before proposing a PyPI release. Pair it with the same cooldown in the package manager (PDM `exclude-newer`, uv `--exclude-newer`), so Renovate never proposes a release the lock file refuses.",
      "matchDatasources": [
        "pypi"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Wait 5 days before proposing an image or a GitHub release (actions included), wherever the source gives release timestamps. A source without them never passes: turn the cooldown off for it in the repository.",
      "matchDatasources": [
        "docker",
        "github-releases",
        "github-tags"
      ],
      "minimumReleaseAge": "5 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Python interpreter upgrades (requires-python, Docker image) need manual work around them and Renovate cannot regenerate a PDM lock file for one, so they wait on the dependency dashboard until approved.",
      "matchDatasources": [
        "python-version",
        "docker"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?(library/)?python$/"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Label the ecosystem an update belongs to.",
      "matchDatasources": [
        "pypi"
      ],
      "addLabels": [
        "deps:python"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "addLabels": [
        "deps:javascript"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "deps:github-actions"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "deps:docker"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "deps:optional"
      ]
    },
    {
      "description": "Label the kind of update.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "update:major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "update:minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "update:patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "update:digest"
      ]
    },
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "addLabels": [
        "update:pin"
      ]
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "update:lockfile"
      ]
    }
  ]
}
