{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for nicebots-xyz repositories.",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "commitMessageAction": "Upgrade",
  "assigneesFromCodeOwners": true,
  "pinDigests": true,
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com",
    "/^\\d+\\+nicebots-autofixer\\[bot\\]@users\\.noreply\\.github\\.com$/"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "labels": [
    "deps"
  ],
  "packageRules": [
    {
      "description": "Commit message verbs for non-upgrade update types.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "commitMessageAction": "Pin"
    },
    {
      "matchUpdateTypes": [
        "rollback"
      ],
      "commitMessageAction": "Downgrade"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "commitMessageAction": "Update lock file"
    },
    {
      "description": "Label the ecosystem an update belongs to.",
      "matchDatasources": [
        "pypi"
      ],
      "addLabels": [
        "deps:python"
      ]
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "addLabels": [
        "deps:javascript"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "deps:github-actions"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "deps:docker"
      ]
    },
    {
      "matchDepTypes": [
        "optionalDependencies"
      ],
      "addLabels": [
        "deps:optional"
      ]
    },
    {
      "description": "Label the kind of update.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "update:major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "update:minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "update:patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "update:digest"
      ]
    },
    {
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "addLabels": [
        "update:pin"
      ]
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "update:lockfile"
      ]
    }
  ]
}
